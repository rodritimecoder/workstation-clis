# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
# No trailing slash: omnicli/.venv is a symlink to an ext4 venv, and a
# directory-only rule would not ignore the symlink itself.
.venv
venv/
env/
ENV/
.env/
.agent-reach-venv/
container-site-packages/

