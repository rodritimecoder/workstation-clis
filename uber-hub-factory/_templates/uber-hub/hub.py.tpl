#!/usr/bin/env python3
"""
{HUB_NAME}.py — Non-Destructive Late-Binding Hub Router
Generated by uber-hub-factory.

Implements the 4-step Uber Protocol + Direct Subcommands:
  1. search  - Intent search across registered suites
  2. list    - Enumerate available suites & tools
  3. inspect - Read exact contract/rubric on-demand from native SKILL.md
  4. run     - Execute with Response Projection (--project) & Disk Buffering (--out)
  5. Direct  - Call suites directly: {HUB_NAME} <suite> [args...]
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

SCRIPT_PATH = Path(__file__).resolve()
if SCRIPT_PATH.parent.name == "scripts":
    HUB_DIR = SCRIPT_PATH.parent.parent
else:
    HUB_DIR = SCRIPT_PATH.parent

SKILLS_DIR = HUB_DIR.parent

# Registry of suites generated by uber-hub-factory
SUITES = {SUITES_DICT_LITERAL}


def resolve_rubric_file(suite_id: str, info: dict) -> Path | None:
    candidates = [
        SKILLS_DIR / suite_id / "SKILL.md",
        SKILLS_DIR / info.get("folder", suite_id) / "SKILL.md",
        HUB_DIR / "suites" / suite_id / "rubric.md",
        HUB_DIR / "suites" / suite_id / "SKILL.md",
        HUB_DIR / f"{suite_id}.md",
    ]
    if "rubric_path" in info:
        candidates.insert(0, Path(info["rubric_path"]))
        candidates.insert(1, HUB_DIR / info["rubric_path"])
        candidates.insert(2, SKILLS_DIR / info["rubric_path"])

    for c in candidates:
        if c.is_file():
            return c
    return None


def resolve_executable(suite_id: str, info: dict) -> list[str] | None:
    folder = info.get("folder", suite_id)
    suite_dir = SKILLS_DIR / folder

    entrypoint = info.get("entrypoint")
    if entrypoint:
        p = Path(entrypoint)
        if p.is_file() and os.access(p, os.X_OK):
            return [sys.executable, str(p)] if p.suffix == ".py" else [str(p)]
        if not p.is_absolute():
            for base in [suite_dir, HUB_DIR / "suites" / suite_id, HUB_DIR]:
                candidate = base / p
                if candidate.is_file():
                    return [sys.executable, str(candidate)] if candidate.suffix == ".py" else [str(candidate)]

    # Look for scripts inside suite_dir / scripts
    scripts_dir = suite_dir / "scripts"
    if scripts_dir.is_dir():
        for sf in scripts_dir.iterdir():
            if sf.is_file() and sf.suffix in (".py", ".sh"):
                return [sys.executable, str(sf)] if sf.suffix == ".py" else [str(sf)]

    # Check root of suite_dir
    for name in [f"{suite_id}.py", f"{folder}.py"]:
        candidate = suite_dir / name
        if candidate.is_file():
            return [sys.executable, str(candidate)]

    # Check system PATH / ~/.local/bin
    which = shutil.which(suite_id) or shutil.which(folder)
    if which:
        return [which]

    return None


def cmd_list(as_json: bool = False):
    if as_json:
        print(json.dumps(list(SUITES.values()), indent=2))
        return

    print(f"\n📦 [{HUB_NAME_UPPER}] Bridged Suites & Capabilities:\n")
    print(f"{'#':<3} {'Suite':<24} {'Description'}")
    print("─" * 70)
    for i, (s_id, info) in enumerate(SUITES.items(), start=1):
        desc = info.get('description', '')
        if len(desc) > 65:
            desc = desc[:62] + "..."
        print(f"{i:<3} {s_id:<24} {desc}")
    print(f"\n💡 Usage: '{HUB_NAME} inspect <suite>' | '{HUB_NAME} run <suite> [args]' | '{HUB_NAME} <suite> [args]'\n")


def cmd_search(query: str, as_json: bool = False):
    q_tokens = query.lower().split()
    scored = []
    for s_id, info in SUITES.items():
        score = 0
        haystack = f"{s_id} {info.get('name', '')} {info.get('description', '')} {' '.join(info.get('tags', []))}".lower()
        for t in q_tokens:
            if t in s_id.lower():
                score += 10
            if t in info.get("description", "").lower():
                score += 5
            score += haystack.count(t)
        if score > 0:
            scored.append((score, s_id, info))

    scored.sort(key=lambda x: x[0], reverse=True)
    if as_json:
        print(json.dumps([s[2] for s in scored], indent=2))
        return

    print(f"\n🔍 [Bridge Search] Query: '{query}'\n")
    if not scored:
        print("  No matching suites found.")
        return

    for score, s_id, info in scored[:5]:
        print(f"  • 🎯 {s_id} (relevance: {score})")
        print(f"    {info.get('description', '')}")
        print(f"    Inspect: {HUB_NAME} inspect {s_id}\n")


def cmd_inspect(suite_id: str):
    info = SUITES.get(suite_id.lower())
    if not info:
        for k in SUITES:
            if k.startswith(suite_id.lower()):
                info = SUITES[k]
                suite_id = k
                break

    if not info:
        sys.exit(f"❌ Error: Unknown suite '{suite_id}'. Available: {', '.join(SUITES.keys())}")

    rubric_file = resolve_rubric_file(suite_id, info)
    if not rubric_file or not rubric_file.is_file():
        sys.exit(f"❌ Error: SKILL.md/rubric not found for suite '{suite_id}'.")

    content = rubric_file.read_text(encoding="utf-8")
    clean_content = re.sub(r"^---\s*\n.*?\n---\s*\n", "", content, flags=re.DOTALL)
    print(f"\n📖 [{HUB_NAME_UPPER} Contract] {info.get('name', suite_id)} ({rubric_file})\n")
    print("=" * 80)
    print(clean_content.strip())
    print("=" * 80)


def apply_response_projection(raw_output: str, project_fields: list = None, jq_expr: str = None) -> str:
    if not raw_output.strip():
        return raw_output

    if jq_expr and shutil.which("jq"):
        try:
            p = subprocess.run(["jq", jq_expr], input=raw_output, text=True, capture_output=True)
            if p.returncode == 0:
                return p.stdout.strip()
        except Exception:
            pass

    if project_fields:
        try:
            data = json.loads(raw_output)
            if isinstance(data, dict):
                filtered = {k: v for k, v in data.items() if k in project_fields}
                return json.dumps(filtered, indent=2)
            elif isinstance(data, list):
                filtered = [
                    {k: v for k, v in item.items() if k in project_fields} if isinstance(item, dict) else item
                    for item in data
                ]
                return json.dumps(filtered, indent=2)
        except Exception:
            pass

    return raw_output


def cmd_run(suite_id: str, extra_args: list, out_path: str = None, project_fields: str = None, jq_expr: str = None):
    info = SUITES.get(suite_id.lower())
    if not info:
        for k in SUITES:
            if k.startswith(suite_id.lower()):
                info = SUITES[k]
                suite_id = k
                break

    if not info:
        sys.exit(f"❌ Error: Unknown suite '{suite_id}'. Available: {', '.join(SUITES.keys())}")

    cmd_prefix = resolve_executable(suite_id, info)
    if not cmd_prefix:
        sys.exit(f"❌ Error: Could not locate executable entrypoint for suite '{suite_id}'.")

    full_cmd = cmd_prefix + extra_args

    if out_path or project_fields or jq_expr:
        res = subprocess.run(full_cmd, capture_output=True, text=True)
        combined = res.stdout
        if res.stderr:
            combined += ("\n" + res.stderr if combined else res.stderr)

        fields = [f.strip() for f in project_fields.split(",")] if project_fields else None
        projected = apply_response_projection(combined, fields, jq_expr)

        if out_path:
            p = Path(out_path).resolve()
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(projected, encoding="utf-8")
            print(f"💾 Output buffered to: {p}")
        else:
            print(projected)

        sys.exit(res.returncode)
    else:
        p = subprocess.run(full_cmd)
        sys.exit(p.returncode)


def main():
    # Check for direct suite shortcut invocation: {HUB_NAME} <suite> [args...]
    if len(sys.argv) > 1 and sys.argv[1] in SUITES:
        suite = sys.argv[1]
        args = sys.argv[2:]
        cmd_run(suite, args)
        return

    parser = argparse.ArgumentParser(
        prog="{HUB_NAME}",
        description="{HUB_DESCRIPTION}"
    )
    sub = parser.add_subparsers(dest="action")

    # 1. list
    p_list = sub.add_parser("list", help="List all bridged suites and capabilities")
    p_list.add_argument("--json", action="store_true", help="Output as JSON")

    # 2. search
    p_search = sub.add_parser("search", help="Search suites by intent or keyword")
    p_search.add_argument("query", help="Intent query")
    p_search.add_argument("--json", action="store_true", help="Output as JSON")

    # 3. inspect
    p_inspect = sub.add_parser("inspect", help="Read exact contract and rubric for 1 suite")
    p_inspect.add_argument("suite", help="Suite identifier")

    # 4. run
    p_run = sub.add_parser("run", help="Execute a suite with Response Projection & Disk Buffering")
    p_run.add_argument("suite", help="Suite identifier to run")
    p_run.add_argument("--out", default=None, help="Buffer raw execution output to disk file")
    p_run.add_argument("--project", default=None, help="Comma-separated fields to project from JSON output")
    p_run.add_argument("--jq", default=None, help="JQ filter expression to project output")
    p_run.add_argument("args", nargs=argparse.REMAINDER, help="Arguments passed to suite")

    args, unknown = parser.parse_known_args()

    if not args.action:
        parser.print_help()
        sys.exit(0)

    if args.action == "list":
        cmd_list(as_json=args.json)
    elif args.action == "search":
        cmd_search(args.query, as_json=args.json)
    elif args.action == "inspect":
        cmd_inspect(args.suite)
    elif args.action == "run":
        extra = args.args + unknown
        cmd_run(args.suite, extra, out_path=args.out, project_fields=args.project, jq_expr=args.jq)


if __name__ == "__main__":
    main()
